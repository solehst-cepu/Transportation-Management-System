# APP_URL: The public URL where LVBMS is hosted (e.g. https://lvbms.vercel.app)
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID for Google Identity Services SSO
GOOGLE_CLIENT_ID=""

# ALLOWED_WORKSPACE_DOMAIN: Google Workspace domain for school users
ALLOWED_WORKSPACE_DOMAIN="lazuardi.sch.id"

# INITIAL_ADMIN_EMAILS: Comma-separated initial Administrator / GA Google emails
INITIAL_ADMIN_EMAILS="soleh.st@lazuardi.sch.id"

# SESSION_SECRET: Long random secret string for signing HttpOnly session cookies
SESSION_SECRET=""

# GOOGLE_SHEETS_SPREADSHEET_ID: Master Google Spreadsheet ID for LVBMS database
GOOGLE_SHEETS_SPREADSHEET_ID=""

# GOOGLE_SERVICE_ACCOUNT_EMAIL: Service Account email with Editor access to Sheet & Drive folder
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# GOOGLE_PRIVATE_KEY: Service Account private key (keep \n newlines escaped if single-line)
GOOGLE_PRIVATE_KEY=""

# GOOGLE_DRIVE_FOLDER_ID: Google Drive folder ID for vehicle photos, inspection photos, and receipts
GOOGLE_DRIVE_FOLDER_ID=""
